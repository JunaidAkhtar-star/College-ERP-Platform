# Server
PORT=5000
HOST=localhost
NODE_ENV=development
API_VERSION=api/v1
TRUST_PROXY_HOPS=0
CONNECTOR_EGRESS_HOSTS=api.twilio.com
CONNECTOR_WEBHOOK_BASE_URL=https://api.example.edu

# Database and cache
MONGODB_URI=mongodb://127.0.0.1:27017
MASTER_DB_NAME=devvelocity_master
REDIS_URL=redis://127.0.0.1:6379
# Required for background and scheduled job delivery.
# Hosted production example: amqps://USER:URL_ENCODED_PASSWORD@HOST/VHOST
RABBITMQ_URL=amqp://erp_user:change-me@127.0.0.1:5672/erp
# Per-worker unacknowledged delivery limit (clamped to 1..1000).
RABBITMQ_PREFETCH=10
# all (single process), api (HTTP/outbox producer), or worker (consumer/schedulers)
JOB_RUNTIME_MODE=all
OPENROUTER_MODEL=z-ai/glm-5.2:free
DEMO_TENANT_DB=

# Authentication and encryption
# Generate independent random values for every deployed environment.
JWT_SECRET=replace-with-at-least-64-random-characters
JWT_REFRESH_SECRET=replace-with-another-64-random-characters
AUDIT_HMAC_SECRET=replace-with-a-third-independent-64-random-character-secret
ENCRYPTION_KEY=replace-with-64-hex-characters

# Application URLs and tenant domains
FRONTEND_URL=http://localhost:3000
APP_NAME=Devvelocity
PLATFORM_WEBSITE_URL=http://localhost:3001
PLATFORM_LOGO_URL=http://localhost:3001/devvelocitylogo.webp
TENANT_APP_URL_TEMPLATE=http://{tenant}.localhost:3000
TENANT_ROOT_DOMAIN=localhost
TENANT_CNAME_TARGET=localhost
ALLOWED_ORIGINS=http://localhost:3000,http://*.localhost:3000,https://localhost:3000,https://*.localhost:3000,http://localhost:3001,http://localhost:3002

# Administrative operations
ADMIN_IP_WHITELIST=
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Provider credentials (Cloudinary, SMTP, Firebase, Razorpay, Agora and
# Google Gemini AI) are configured dynamically in Admin > Integration Center.
GEMINI_API_KEY=


# Tenant database backup tooling
MONGODUMP_PATH=mongodump

# Institution and generated documents
COLLEGE_NAME=Institution
PUPPETEER_EXEC_PATH=


# Data retention in days (0 disables the corresponding purge)
NOTIFICATION_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=90
SOFT_DELETE_PURGE_DAYS=30
ACTIVE_SESSION_RETENTION_DAYS=7
NOTICE_READ_RETENTION_DAYS=180
DELETED_CHAT_MESSAGE_RETENTION_DAYS=30

# Optional seed configuration
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASS=
SEED_ADMIN_PHONE=
SEED_INSTITUTION_NAME=
SEED_CORE_CURRICULA=false
SEED_CURRICULUM_REGULATION_YEAR=
ERP_ASSISTANT_HISTORY_RETENTION_DAYS=90
GEMINI_FALLBACK_MODEL=
GEMINI_MODEL=
GROQ_API_KEY=
MONGO_QUERY_MAX_TIME_MS=10000
OPENROUTER_API_KEY=
