    "next": "16.2.11",
    "nextjs-toploader": "^3.9.17",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-toastify": "^11.1.0",
    "recharts": "^3.8.1",
    "sweetalert2": "^11.26.25",
    "swr": "^2.4.1",
